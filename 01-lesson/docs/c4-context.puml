@startuml
!include C4_Context.puml

title Weather Lens Bot — System Context
LAYOUT_LEFT_RIGHT()

Person(user, "Telegram User", "Отправляет название города и получает прогноз")
System(bot, "Weather Lens Bot", "Telegram-бот с текущей погодой и прогнозом на три дня")
System_Ext(telegram, "Telegram", "Доставляет сообщения и webhook updates")
System_Ext(openMeteo, "Open-Meteo API", "Геокодирование города и погодный прогноз")

Rel(user, telegram, "Общается", "Telegram")
Rel(telegram, bot, "Передаёт update", "HTTPS webhook")
Rel(bot, telegram, "Отправляет ответ", "Telegram Bot API / HTTPS")
Rel(bot, openMeteo, "Запрашивает прогноз", "HTTPS / JSON")
@enduml
